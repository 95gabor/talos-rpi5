From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: talos-build <talos-build@local>
Date: Wed, 27 May 2026 12:00:00 +0000
Subject: [PATCH] ARM: dts: bcm2712-rpi-cm5: drop broken-cd on sdio1

broken-cd forces MMC_CAP_NEEDS_POLL and causes perpetual mmc0 SDHCI
timeouts on NVMe/USB-only boots with an empty microSD slot.
See: https://github.com/siderolabs/sbc-raspberrypi/issues/92
---
 arch/arm64/boot/dts/broadcom/bcm2712-rpi-cm5.dtsi | 1 -
 1 file changed, 1 deletion(-)

diff --git a/arch/arm64/boot/dts/broadcom/bcm2712-rpi-cm5.dtsi b/arch/arm64/boot/dts/broadcom/bcm2712-rpi-cm5.dtsi
--- a/arch/arm64/boot/dts/broadcom/bcm2712-rpi-cm5.dtsi
+++ b/arch/arm64/boot/dts/broadcom/bcm2712-rpi-cm5.dtsi
@@ -291,7 +291,6 @@
 	sd-uhs-ddr50;
 	sd-uhs-sdr104;
 	mmc-hs200-1_8v;
-	broken-cd;
 	status = "okay";
 };
